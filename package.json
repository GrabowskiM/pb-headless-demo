{
  "name": "pb-headless-demo",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "prettier:check": "prettier \"./src/**/*.{ts,tsx,css}\" --check",
    "prettier:fix": "npm run prettier:check -- --write",
    "eslint:check": "eslint \"./src/**/*.{ts,tsx}\"",
    "eslint:fix": "npm run eslint:check -- --fix",
    "ts:check": "tsc --noEmit",
    "cs:check": "npm run prettier:check && npm run eslint:check && npm run ts:check",
    "cs:fix": "npm run prettier:fix && npm run eslint:fix && npm run ts:check"
  },
  "dependencies": {
    "@ibexa/react-headless": "^0.0.1",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@ibexa/eslint-config": "github:ibexa/eslint-config-ibexa#v2.0.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.26.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "prettier": "@ibexa/eslint-config/prettier"
}
